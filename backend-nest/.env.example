# Copie para .env somente em desenvolvimento. Nunca versione valores reais.
PORT=8000
NODE_ENV=development

# Banco de DESENVOLVIMENTO. Nunca aponte para produção ao testar.
DATABASE_URL=postgresql://givova:CHANGE_ME@localhost:5432/givova_ti
# No Railway use DATABASE_URL=${{Postgres.DATABASE_URL}} (rede privada) e DATABASE_SSL=false.
# true exige TLS com certificado válido (conexões externas).
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Lista JSON com as origens do frontend autorizadas (CORS + escrita).
ALLOWED_ORIGINS=["http://localhost:3000"]
# Em produção (HTTPS) deve ser true. Use false apenas em http://localhost.
COOKIE_SECURE=false
SESSION_HOURS=8
TIMEZONE=America/Sao_Paulo

# Número de proxies reversos confiáveis à frente da API.
# 0 = não confiar em X-Forwarded-For. No Railway o padrão já é 1.
TRUST_PROXY=0

# Endereço de escuta (:: = IPv6 + IPv4) e tempo de drenagem após SIGTERM.
# HOST=::
# SHUTDOWN_GRACE_SECONDS=10

# Limite de login: tentativas por usuário+IP e por IP em 5 minutos.
LOGIN_MAX_ATTEMPTS=10
LOGIN_MAX_ATTEMPTS_PER_IP=30

# Metas de 1º atendimento (minutos) por prioridade. OPCIONAL: sem esta variável
# nenhum chamado é marcado como "Atrasado". Os valores abaixo são apenas um
# EXEMPLO — defina-os conforme a política aprovada pela empresa.
# SLA_FIRST_RESPONSE_MINUTES={"URGENTE":15,"ALTA":30,"NORMAL":120,"BAIXA":480}

# Limite de chamados abertos por IP a cada 10 minutos (endpoint público).
# Atrás do proxy do cPanel todos os colaboradores compartilham o mesmo IP.
TICKET_CREATE_MAX_PER_IP=60

# Web Push (notificações do computador). Reutilize o par já usado em produção.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ti@example.com

# json (produção) ou pretty (desenvolvimento)
LOG_FORMAT=pretty
