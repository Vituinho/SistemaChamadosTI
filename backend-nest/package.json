{
  "name": "givova-ti-api",
  "version": "2.1.0",
  "private": true,
  "description": "API NestJS da central de chamados de TI da Givova Transportes",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:test": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "dev": "npm run build && node --env-file-if-exists=.env dist/src/main.js",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "migrate": "node --env-file-if-exists=.env dist/src/cli/cli.js migrate",
    "cli": "node --env-file-if-exists=.env dist/src/cli/cli.js",
    "test": "npm run build:test && node --test --test-concurrency=1 \"dist/test/unit/*.test.js\" \"dist/test/integration/*.test.js\"",
    "test:unit": "npm run build:test && node --test \"dist/test/unit/*.test.js\"",
    "test:integration": "npm run build:test && node --test --test-concurrency=1 \"dist/test/integration/*.test.js\"",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.9.3"
  }
}
