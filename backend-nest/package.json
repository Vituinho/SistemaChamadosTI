{
  "name": "givova-ti-nest-api",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run build && node --env-file-if-exists=.env dist/src/main.js",
    "build": "tsc --project tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "test": "node --test dist/tests/*.test.js",
    "check": "npm run build && npm test",
    "create-user": "node --env-file-if-exists=.env dist/src/create-user.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.9.0"
  }
}
